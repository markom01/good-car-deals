generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id           BigInt   @id @default(autoincrement())
  listingUrl   String   @unique @map("listing_url")
  title        String
  price        String
  priceNumeric BigInt?  @map("price_numeric")
  priceNote    String?  @map("price_note")
  year         Int?
  age          Int?
  mileageKm    Int?     @map("mileage_km")
  model        String?
  dealType     String?  @map("deal_type")
  dealScore    Float?   @map("deal_score")
  pricePerYear Float?   @map("price_per_year")
  fuelType     String?  @map("fuel_type")
  engineCc     Int?     @map("engine_cc")
  powerKw      Int?     @map("power_kw")
  transmission String?
  location     String?
  /// "Poreklo vozila" from the feed tags: domestic | foreign | null
  plateOrigin  String?  @map("plate_origin")
  expectedPrice Float?  @map("expected_price")
  deviationPct Float?   @map("deviation_pct")
  scrapedAt    DateTime @default(now()) @map("scraped_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([dealScore])
  @@index([dealType])
  @@index([model])
  @@index([scrapedAt])
  @@map("listings")
}

/// Scrape checkpoint so an interrupted run resumes where it stopped
/// instead of refetching every page already saved.
model ScrapeProgress {
  key       String   @id
  targetUrl String   @map("target_url")
  lastPage  Int      @map("last_page")
  pageCount Int      @map("page_count")
  /// "running" = resumable, "done" = next run starts fresh
  status    String
  startedAt DateTime @map("started_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scrape_progress")
}

model PushSubscription {
  endpoint  String   @id
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

model SeenWillhabenAd {
  id     String   @id
  seenAt DateTime @default(now()) @map("seen_at")

  @@index([seenAt])
  @@map("seen_willhaben_ads")
}
