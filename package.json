{
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,frontend -c blue,green \"npm run start:api\" \"npm run dev:frontend\"",
    "start:api": "cd good-car-deals-api && node dist/src/main.js",
    "dev:frontend": "npm --prefix good-car-deals-frontend run dev"
  },
  "workspaces": [
    "packages/*",
    "good-car-deals-api",
    "good-car-deals-frontend"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "shadcn": "^4.7.0"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
